{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run check:build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:smoke": "playwright test",
    "cv": "node scripts/build-cv.ts",
    "og": "node scripts/build-og.ts",
    "photos": "node scripts/build-photos.ts",
    "shots": "node scripts/build-shots.ts",
    "check:tokens": "node scripts/check-tokens.ts",
    "check:data": "node --test scripts/lib/validate-data.test.ts && node scripts/check-data.ts",
    "check:build": "node scripts/check-build.ts",
    "check:release": "npm run lint && npm run check:tokens && npm run check:data && npm run cv -- --check && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "framer-motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.16.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "mp4box": "^2.6.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0"
  },
  "engines": {
    "node": "26.x"
  }
}
